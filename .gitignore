venv
pycache
__pycache__/
.DS_Store
.env
*.log
*.lock
# session state is per-machine runtime data (SS-2) — never tracked
.agent/sessions/
.agent/rules/localization-sync.md


# run-feedback machine state (inbox/journal/locks) — never tracked
.agent/feedback/

# Atomic-write temp files: mkstemp names them unpredictably inside the target
# directory, so a crash between write and rename can leave one in a TRACKED dir
# (docs/). Ignoring them keeps `git add -A` from committing a half-written ledger
# (vdd-multi S-04 / F16 / V-10).
*.tmp.*
*.md.tmp*

# Rollback backups written by /framework-upgrade before it edits core files
# (`.agent/archive/<file>.bak`). They are local recovery state for one run — the
# tracked copy of every one of them is the git history itself. Untracked and
# un-ignored, they left `git status` dirty after every upgrade.
.agent/archive/

# Test scratch space. Most tests write to system temp, but a few scripts under test
# reject paths outside the repository root, so their workspace MUST live in the tree
# (tests/_scratch.py explains which). The suite sweeps this at session start and end;
# ignoring it means a run killed before its teardown cannot dirty the tree either.
tests/.scratch/
