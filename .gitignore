venv
pycache
__pycache__/
.DS_Store
.env
*.log
*.lock
# session state is per-machine runtime data (SS-2) — never tracked
.agent/sessions/
.agent/rules/localization-sync.md


# run-feedback machine state (inbox/journal/locks) — never tracked
.agent/feedback/

# Atomic-write temp files: mkstemp names them unpredictably inside the target
# directory, so a crash between write and rename can leave one in a TRACKED dir
# (docs/). Ignoring them keeps `git add -A` from committing a half-written ledger
# (vdd-multi S-04 / F16 / V-10).
*.tmp.*
*.md.tmp*
