{
  "schema": "register-rules/v1",
  "thresholds": {
    "sentence_max_words": 35,
    "sentence_near_words": 30,
    "cell_max_chars": 120,
    "cell_max_sentences": 1
  },
  "languages": {
    "ru": {
      "reasoning": {
        "modals": [
          "\\bобязан\\w*\\b",
          "\\bдолж(ен|на|но|ны)\\b",
          "\\bнельзя\\b",
          "\\bзапрещ(ён|ен|ена|ено|ены)\\b",
          "\\bтребуется\\b",
          "\\bне имеет права\\b"
        ],
        "causals": [
          "\\bпотому что\\b",
          "\\bпоскольку\\b",
          "\\bтак как\\b",
          "\\bведь\\b",
          "\\bиначе\\b",
          "\\bоттого что\\b",
          "\\bпо той причине\\b"
        ],
        "probe": "Докстринг обязан назвать механизм, потому что иначе читатель примет удалённое поле за действующее."
      },
      "categories": [
        {
          "name": "оценочные утверждения",
          "entries": [
            {
              "marker": "разумеется",
              "pattern": "\\bразумеется\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Разумеется, поле остаётся обязательным.",
              "guidance": "Удалить. Если это разумеется, предложение не нужно."
            },
            {
              "marker": "очевидно / неочевидно",
              "pattern": "\\b(не)?очевид(н\\w*|ен)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Порядок здесь неочевиден, а самый очевидный способ неверен.",
              "guidance": "Удалить или привести факт, из которого это следует. «Неочевидно» — то же самое: назвать, что именно читатель прочтёт неверно.",
              "note": "Беглая гласная в краткой форме обязательна: «очевиден» не содержит основы «очевидн», и шаблон \\bочевидн\\w* пропускал каждое вхождение краткой формы в корпусе."
            },
            {
              "marker": "попросту",
              "pattern": "\\bпопросту\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Механизм попросту не нужен.",
              "guidance": "Удалить. Читатель не может проверить эту оценку."
            },
            {
              "marker": "на самом деле",
              "pattern": "\\bна самом деле\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "На самом деле поле читает только валидатор.",
              "guidance": "Удалить рамку и сформулировать сам факт."
            },
            {
              "marker": "стоит отметить",
              "pattern": "\\bстоит отмети(ть|м)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Стоит отметить, что счётчик устарел.",
              "guidance": "Удалить рамку и написать наблюдение."
            },
            {
              "marker": "важно понимать",
              "pattern": "\\bважно (понимать|помнить|отметить)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Важно понимать, что резерв делается один раз.",
              "guidance": "Удалить. Требование не становится сильнее от указания на его важность."
            },
            {
              "marker": "элегантно",
              "pattern": "\\bэлегантн\\w*\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Решение элегантное и короткое.",
              "guidance": "Заменить на свойство, которое имеется в виду."
            },
            {
              "marker": "честно",
              "pattern": "\\bчестн(о|ый|ая|ое|ые)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Гейт честный и проверяет всё.",
              "guidance": "Назвать проверяемое свойство вместо оценки.",
              "note": "«Честный гейт» — оценка; «гейт проверяет X» — требование."
            },
            {
              "marker": "наивный",
              "pattern": "\\bнаив(н\\w*|ен)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Наивный вариант наивен и дал бы неверный результат.",
              "guidance": "Назвать конкретную реализацию и то, на каком входе она неверна. «Наивный» — оценка чужого решения, а не его описание."
            },
            {
              "marker": "ловушка",
              "pattern": "\\bловушк\\w*\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Соседняя строка — ловушка для правки.",
              "guidance": "Назвать ошибку, которую здесь совершают, и условие, при котором она возникает."
            },
            {
              "marker": "коварный",
              "pattern": "\\bковарн\\w*\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Коварный случай возникает на границе.",
              "guidance": "Назвать вход, на котором механизм ведёт себя не так, как читается."
            },
            {
              "marker": "красиво / изящно",
              "pattern": "\\b(красив|изящн)\\w*\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Изящное решение не требует правок.",
              "guidance": "Заменить на свойство: короче на N строк, не добавляет параметров, не трогает продовую поверхность."
            },
            {
              "marker": "к сожалению / увы",
              "pattern": "\\b(к сожалению|увы)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "К сожалению, ключ приходится делать обязательным.",
              "guidance": "Удалить. Ограничение описывается, а не оплакивается."
            },
            {
              "marker": "главная опасность / главная проблема",
              "pattern": "\\bглавн(ая|ое|ый)\\s+(опасность|проблема|риск|мысль|идея|сложность)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Главная опасность задачи — неверное доказательство.",
              "guidance": "Ранжирование без шкалы непроверяемо. Назвать риск и его последствие, а «главный» удалить или заменить на severity."
            },
            {
              "marker": "самое важное / суть в том",
              "pattern": "\\b(самое (важное|главное)|суть в том)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Самое важное здесь — порядок шагов.",
              "guidance": "Удалить рамку и написать само утверждение."
            },
            {
              "marker": "тонкое место / тонкий момент",
              "pattern": "\\bтонк(ое место|ий момент|ость)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Тонкий момент здесь в порядке конструирования.",
              "guidance": "Назвать конкретное условие, на котором ошибаются."
            }
          ]
        },
        {
          "name": "маркетинговая лексика в спецификации",
          "entries": [
            {
              "marker": "бесшовный",
              "pattern": "\\bбесшовн\\w*\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Переход бесшовный для вызывающего.",
              "guidance": "Назвать, чего именно не приходится делать пользователю.",
              "note": "Маркетинговый регистр; см. references/measurement-baseline.md §4."
            },
            {
              "marker": "краеугольный",
              "pattern": "\\bкраеугольн\\w*\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Это краеугольный механизм системы.",
              "guidance": "Назвать, что именно от этого зависит."
            },
            {
              "marker": "играет ключевую роль",
              "pattern": "\\bигра(ет|ют) ключев\\w+ роль\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 2,
              "probe": "Кеш играет ключевую роль в обходе.",
              "guidance": "Написать, что сломается без этого."
            }
          ]
        },
        {
          "name": "усиление, которое иногда несёт смысл",
          "entries": [
            {
              "marker": "ровно",
              "pattern": "\\bровно\\b",
              "flags": "i",
              "severity": "info",
              "rule": 2,
              "probe": "Вызов происходит ровно один раз.",
              "guidance": "Оставить при точном количестве («ровно один раз»); удалить в «ровно тот механизм»."
            },
            {
              "marker": "именно",
              "pattern": "\\bименно\\b",
              "flags": "i",
              "severity": "info",
              "rule": 2,
              "probe": "Правится именно этот докстринг.",
              "guidance": "Оставить, когда указывает на конкретный объект; удалить, когда только усиливает."
            },
            {
              "marker": "просто",
              "pattern": "\\bпросто\\b",
              "flags": "i",
              "severity": "info",
              "rule": 2,
              "probe": "Это просто ещё одно поле.",
              "guidance": "Обычно удаляется. Оставить только в противопоставлении названной альтернативе.",
              "note": "Не срабатывает на «простой» и «прост.» — шаблон закрыт границей слова."
            }
          ]
        },
        {
          "name": "правило 4 — максима и олицетворение вместо нормы",
          "entries": [
            {
              "marker": "не может провалиться",
              "pattern": "\\bне мож(ет|но) провалиться\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Такая проверка не может провалиться.",
              "guidance": "Это диагноз, а не требование. Написать требование: «тест обязан иметь вход, на котором падает», и назвать этот вход."
            },
            {
              "marker": "ничего не проверяет / не доказывает",
              "pattern": "\\bничего не (провер|доказ)\\w+",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Тест ничего не проверяет.",
              "guidance": "Назвать утверждение, которое осталось непокрытым, вместо обобщения."
            },
            {
              "marker": "вечно зелёный",
              "pattern": "\\bвечно зел[её]н\\w*\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Сторож остаётся вечно зелёным.",
              "guidance": "Написать наблюдаемое свойство: «нет входа, на котором сторож падает»."
            },
            {
              "marker": "снятие которого не роняет",
              "pattern": "\\bснятие которого не рон\\w+",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Свойство, снятие которого не роняет ничего.",
              "guidance": "Сформулировать как критерий: «мутация M обязана уронить тест T». Максима не исполняется."
            },
            {
              "marker": "краснеет / зеленеет (о тесте)",
              "pattern": "\\b(по)?(красне|зелене)(ет|ют|л|ла|ло|ли|я|ть)\\b|\\bкраснит\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Гейт краснеет, а затем позеленеет.",
              "guidance": "Олицетворение. Написать «падает» / «проходит» и назвать условие.",
              "note": "Прилагательные «красная фаза», «зелёный прогон» — термин Red-Green-Refactor и НЕ ловятся: шаблон закрыт на глагольные формы."
            },
            {
              "marker": "благословит (о гейте)",
              "pattern": "\\bблагослов\\w+",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Гейт благословит это число.",
              "guidance": "Олицетворение. Написать «пропустит» / «примет как соответствующее»."
            },
            {
              "marker": "кусается / проверен на укус",
              "pattern": "\\b(на укус|укус\\w*|кусает\\w*)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Проверить, что гейт кусается.",
              "guidance": "Написать процедуру: «внести нарушение N, увидеть падение теста T, откатить»."
            },
            {
              "marker": "переживший (о комментарии, правиле)",
              "pattern": "\\bпережи(л|ла|ло|ли|вш\\w+)\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Комментарий, переживший свою причину.",
              "guidance": "Олицетворение в роли нормы. Назвать, что устарело и в какой момент."
            },
            {
              "marker": "бьёт / душит (о механизме)",
              "pattern": "\\b(бь[её]т|душ(ит|ат)|убива(ет|ют))\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 4,
              "probe": "Дедлайн бьёт по неоплаченным вызовам.",
              "guidance": "Олицетворение. Назвать действие механизма: «отменяет», «прерывает», «отказывает»."
            },
            {
              "marker": "молча / тихо (о механизме)",
              "pattern": "\\b(молч(а|ит|ат|аливо)|тих(ая|ий|ое|ую)\\s+(ложь|правка|подмена|откат))\\b",
              "flags": "i",
              "severity": "info",
              "rule": 4,
              "probe": "Правка молча ломает проверку.",
              "guidance": "Оставить, если «без диагностики» — проверяемый факт; заменить, если это только окраска. Назвать, ЧТО именно не выводится и куда."
            }
          ]
        },
        {
          "name": "правило 6 — приватная метафора вместо термина",
          "entries": [
            {
              "marker": "шов",
              "pattern": "\\b(шов|шв(ов|ы|а|е|у|ам|ами))\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 6,
              "probe": "Шов инъекции строится здесь, и два шва закрываются.",
              "guidance": "Заменить на «точка внедрения зависимости». Пример правила 6 в references/formalization-guide.md."
            },
            {
              "marker": "бусина",
              "pattern": "\\bбусин\\w+",
              "flags": "i",
              "severity": "warn",
              "rule": 6,
              "probe": "Бусина 3.5 требует проверки.",
              "guidance": "Заменить на «пункт плана» либо на идентификатор рабочего элемента."
            },
            {
              "marker": "нога / плечо (вызова)",
              "pattern": "\\b(ног(а|и|у|ой|ах)|плеч(о|а|у|ом|и|ах))\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 6,
              "probe": "Платное плечо доигрывает, а вторая нога отменяется.",
              "guidance": "Заменить на «подвызов» либо «этап вызова»."
            },
            {
              "marker": "в полёте",
              "pattern": "\\bв пол[её]те\\b",
              "flags": "i",
              "severity": "warn",
              "rule": 6,
              "probe": "Промис лидера в полёте.",
              "guidance": "Заменить на «незавершённый» либо «выполняющийся»."
            },
            {
              "marker": "голова / хвост (вызова)",
              "pattern": "\\b(голов(а|ы|у|е|ой)|хвост\\w*)\\b",
              "flags": "i",
              "severity": "info",
              "rule": 6,
              "probe": "Отменяемая голова ограничена, хвост нет.",
              "guidance": "Если это части вызова — заменить на «отменяемая часть» / «неотменяемая часть». Если слово употреблено в прямом значении, оставить.",
              "note": "info: слово частотно и имеет прямое значение. Решение за автором — так предписывает раздел «Execution Mode»."
            },
            {
              "marker": "мост (о трансляции)",
              "pattern": "\\bмост(ик)?(ом|а|у|ы|ов|е)?\\b",
              "flags": "i",
              "severity": "info",
              "rule": 6,
              "probe": "Тем мостом, который уже построен.",
              "guidance": "Если речь о преобразовании типа ошибки — заменить на «трансляция». Паттерн Bridge как термин ООП оставить верватим."
            }
          ]
        }
      ]
    }
  }
}
