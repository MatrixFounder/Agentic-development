-#: TASK 116 R8.7: the characters a rewrite may add to a link; any other is counted.
-_LINK_SAFE = frozenset("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._~/%-")
